# Supabase > Project Settings > API
# Use the PUBLISHABLE (public) key, NEVER a service_role / secret key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# For the admin ledger, all entries use INR. There is no payment gateway yet.
# Everything prefixed VITE_ is visible in compiled browser JavaScript.
# Build-only public website origin (set in your hosting build environment, not VITE_):
# PUBLIC_SITE_URL=https://your-real-domain.example
# Without it the site still builds, but omits the absolute-canonical sitemap.
# Optional build-only public tool list if your admin has hidden/published specific tools:
# PUBLIC_ENABLED_TOOLS=calculator,converter,currency
# This must be kept in sync with Supabase published settings manually/through trusted CI.
# Supabase Auth hashes passwords; never include user passwords, SUPABASE_SERVICE_ROLE_KEY, SENTRY_AUTH_TOKEN, database password,
# payment secrets and recovery keys MUST remain on trusted infrastructure, NEVER VITE_.
